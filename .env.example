# Resend — from resend.com → API Keys
RESEND_API_KEY=

# Supabase — service role (server-only, bypasses RLS: used by API routes + cron)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase — public (browser + server, RLS-scoped: used by the dashboard/auth)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# QStash — from console.upstash.com → QStash (drives scheduled job sends)
QSTASH_URL=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Only needed for "digest" type scheduled jobs (see docs/scheduled-jobs)
MARKET_ANALYTICS_URL=
